# Server Configuration
PORT=5001
NODE_ENV=development
FRONTEND_URL=http://localhost:5175

# PostgreSQL Database (Neon or Managed PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/balancevault?schema=balancevault_app"

# Redis Configuration (Optional - in-memory fallback enabled when not configured)
REDIS_URL="redis://localhost:6379"

# JWT Authentication Secrets
JWT_SECRET="balancevault_super_secure_jwt_secret_key_2026_snovasys"
JWT_EXPIRES_IN="24h"

# Seed Admin Credentials (created on first seed/bootstrap)
SEED_ADMIN_EMAIL="admin@balancevault.internal"
SEED_ADMIN_PASSWORD="AdminSecure#2026"
SEED_ADMIN_FIRSTNAME="Platform"
SEED_ADMIN_LASTNAME="Admin"
