// BalanceVault PostgreSQL Schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  ACCOUNT_HOLDER
}

enum OnboardingStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  PENDING
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

enum TransactionType {
  TRANSFER
  DEPOSIT
  WITHDRAWAL
}

enum LedgerEntryType {
  DEBIT
  CREDIT
}

enum AuditOutcome {
  SUCCESS
  FAILURE
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  passwordHash String
  role         Role          @default(ACCOUNT_HOLDER)
  firstName    String
  lastName     String
  phone        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  onboarding   Onboarding?
  accounts     Account[]
  auditLogs    AuditLog[]    @relation("ActorAuditLogs")

  @@index([email])
  @@index([role])
}

model Onboarding {
  id               String           @id @default(uuid())
  userId           String           @unique
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  panNumber        String           @unique
  aadharNumber     String           @unique
  dateOfBirth      DateTime
  address          String
  annualIncome     Int
  employmentStatus String
  status           OnboardingStatus @default(PENDING)
  rejectionReason  String?
  reviewedBy       String?
  reviewedAt       DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([status])
  @@index([userId])
}

model Account {
  id            String        @id @default(uuid())
  accountNumber String        @unique
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  balance       BigInt        @default(0) // Represented in integer paise
  currency      String        @default("INR")
  status        AccountStatus @default(PENDING)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  sentTransfers     Transaction[] @relation("SenderAccount")
  receivedTransfers Transaction[] @relation("ReceiverAccount")
  ledgerEntries     LedgerEntry[]

  @@index([userId])
  @@index([accountNumber])
  @@index([status])
}

model Transaction {
  id                String            @id @default(uuid())
  idempotencyKey    String            @unique
  senderAccountId   String
  senderAccount     Account           @relation("SenderAccount", fields: [senderAccountId], references: [id], onDelete: Restrict)
  receiverAccountId String
  receiverAccount   Account           @relation("ReceiverAccount", fields: [receiverAccountId], references: [id], onDelete: Restrict)
  amount            BigInt            // In paise
  fee               BigInt            @default(0)
  type              TransactionType   @default(TRANSFER)
  status            TransactionStatus @default(PENDING)
  description       String?
  failureReason     String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  ledgerEntries     LedgerEntry[]

  @@index([senderAccountId])
  @@index([receiverAccountId])
  @@index([status])
  @@index([createdAt])
}

model LedgerEntry {
  id            String          @id @default(uuid())
  transactionId String
  transaction   Transaction     @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  accountId     String
  account       Account         @relation(fields: [accountId], references: [id], onDelete: Restrict)
  entryType     LedgerEntryType
  amount        BigInt          // In paise
  balanceAfter  BigInt          // In paise
  createdAt     DateTime        @default(now())

  @@index([transactionId])
  @@index([accountId])
  @@index([createdAt])
}

model AuditLog {
  id               String       @id @default(uuid())
  actorId          String?
  actor            User?        @relation("ActorAuditLogs", fields: [actorId], references: [id], onDelete: SetNull)
  action           String
  targetResource   String
  targetResourceId String?
  outcome          AuditOutcome
  ipAddress        String?
  userAgent        String?
  requestId        String?
  metadata         Json?
  createdAt        DateTime     @default(now())

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
}

model IdempotencyRecord {
  id                 String   @id @default(uuid())
  key                String   @unique
  userId             String
  endpoint           String
  requestHash        String
  responseStatusCode Int?
  responseBody       Json?
  lockedAt           DateTime @default(now())
  expiresAt          DateTime

  @@index([key])
  @@index([expiresAt])
}
